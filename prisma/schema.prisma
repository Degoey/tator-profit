// Tatorprofit — Prisma schema
// All monetary and percentage values use exact decimal types (never floats).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

/// Capability level of an administrator account. `User.adminRole` is nullable so
/// a new administrator has no financial capability until one is granted.
enum AdminRole {
  SUPER_ADMIN
  FINANCE
  SUPPORT
  COMPLIANCE
  VIEWER
}

enum DepositStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  FLAGGED
}

enum WithdrawalStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

enum ProgramStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum UserProgramStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  SUSPENDED
}

enum TransactionType {
  PROGRAM_JOIN
  REWARD
  REFERRAL_REWARD
  WITHDRAWAL
  ADJUSTMENT
  /// Explicit administrator balance credit (Tahap 3). Always appended together
  /// with an `admin.credit_granted` audit row; declared last because PostgreSQL
  /// appends new enum values at the end of the type.
  ADMIN_CREDIT
  /// Member share of an approved weekly trading report (Modul Profit Trading).
  /// Declared last for the same PostgreSQL reason as ADMIN_CREDIT: new enum
  /// values are appended at the end of the type.
  PROFIT_SHARE
}

enum TransactionStatus {
  PENDING
  POSTED
  REVERSED
}

enum RewardType {
  WEEKLY
  CYCLE
}

enum RewardStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  VOID
}

enum ReferralStatus {
  ACTIVE
  INACTIVE
}

enum ReferralCommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  VOID
}

enum NotificationType {
  SYSTEM
  PROGRAM
  REWARD
  REFERRAL
  SECURITY
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PASSWORD_RESET_REQUESTED
  PASSWORD_CHANGED
  SESSION_REVOKED
  RATE_LIMITED
  FRAUD_FLAGGED
}

enum FraudReviewStatus {
  OPEN
  CLEARED
  CONFIRMED
}

model FraudReview {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @unique @db.Uuid
  signals        String[]
  relatedUserIds String[]          @db.Uuid
  status         FraudReviewStatus @default(OPEN)
  reviewerId     String?           @db.Uuid
  reviewNote     String?
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())

  user     User  @relation("FraudSubject", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("FraudReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

enum SecuritySeverity {
  INFO
  WARNING
  CRITICAL
}

model Profile {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  referralCode   String   @unique
  displayName    String?
  avatarUrl      String?
  country        String?
  city           String?
  addressLine    String?
  postalCode     String?
  timezone       String   @default("UTC")
  locale         String   @default("id-ID")
  bio            String?
  marketingOptIn Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  /// Waktu sesi ini terakhir lolos verifikasi kode 2FA pemilik (step-up).
  /// `null` untuk sesi biasa dan untuk sesi pemilik yang belum diverifikasi.
  totpVerifiedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Program {
  id                 String        @id @default(uuid()) @db.Uuid
  code               String        @unique
  name               String
  description        String?
  currency           String        @default("USDT")
  weeklyRewardRate   Decimal       @default(0.1000) @db.Decimal(7, 4)
  cycleWeeks         Int           @default(4)
  maxCycleRewardRate Decimal       @default(0.4000) @db.Decimal(7, 4)
  rewardTerms        String?
  status             ProgramStatus @default(ACTIVE)
  isDefault          Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tiers        ProgramTier[]
  cycles       ProgramCycle[]
  userPrograms UserProgram[]
  rewards      Reward[]

  @@index([status])
}

model ProgramTier {
  id         String   @id @default(uuid()) @db.Uuid
  programId  String   @db.Uuid
  code       String
  name       String
  joinAmount Decimal  @db.Decimal(18, 2)
  currency   String   @default("USDT")
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  program      Program       @relation(fields: [programId], references: [id], onDelete: Restrict)
  userPrograms UserProgram[]
  rewards      Reward[]

  @@unique([programId, code])
  @@unique([programId, joinAmount])
  @@index([programId, isActive, sortOrder])
}

/// One selectable duration of the reward program (4 / 8 / 12 weeks). The 9 join
/// amounts (`ProgramTier`) x these 3 cycles are the 27 program combinations.
/// `targetCycleRewardRate` is the exact `weeklyRewardRate * cycleWeeks` snapshot
/// (40% / 80% / 120%), stored as Decimal so no financial value is ever a float.
model ProgramCycle {
  id                    String   @id @default(uuid()) @db.Uuid
  programId             String   @db.Uuid
  /// Duration in weeks: 4, 8 or 12. Never more than 12.
  cycleWeeks            Int
  weeklyRewardRate      Decimal  @db.Decimal(7, 4)
  targetCycleRewardRate Decimal  @db.Decimal(7, 4)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  program      Program       @relation(fields: [programId], references: [id], onDelete: Restrict)
  userPrograms UserProgram[]

  @@unique([programId, cycleWeeks])
  @@index([programId, isActive, cycleWeeks])
}

model UserProgram {
  id                   String            @id @default(uuid()) @db.Uuid
  userId               String            @db.Uuid
  programId            String            @db.Uuid
  tierId               String            @db.Uuid
  cycleId              String?           @db.Uuid
  joinAmount           Decimal           @db.Decimal(18, 2)
  currency             String            @default("USDT")
  /// Contract snapshot: the rates agreed at join time, so later config edits
  /// cannot silently change an existing membership's reward targets.
  weeklyRewardRate     Decimal           @db.Decimal(7, 4)
  cycleWeeks           Int               @default(4)
  maxCycleRewardRate   Decimal           @db.Decimal(7, 4)
  status               UserProgramStatus @default(PENDING)
  cycleNumber          Int               @default(1)
  weeksCompleted       Int               @default(0)
  /// Program funds are recorded by an administrator after the money arrived
  /// outside the platform; they are never mixed into the reward balance.
  fundsConfirmedAt     DateTime?
  fundsConfirmedAmount Decimal           @default(0) @db.Decimal(18, 2)
  referralCodeUsed     String?
  joinedAt             DateTime          @default(now())
  activatedAt          DateTime?
  completedAt          DateTime?
  suspendedAt          DateTime?
  cancelledAt          DateTime?
  notes                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  program         Program          @relation(fields: [programId], references: [id], onDelete: Restrict)
  tier            ProgramTier      @relation(fields: [tierId], references: [id], onDelete: Restrict)
  cycle           ProgramCycle?    @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  rewards         Reward[]
  transactions    Transaction[]
  depositRequests DepositRequest[]

  @@index([userId, status])
  @@index([tierId])
  @@index([programId, status])
}

model Balance {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @db.Uuid
  currency           String   @default("USDT")
  /// Spendable reward balance (only PAID rewards land here).
  availableAmount    Decimal  @default(0) @db.Decimal(18, 2)
  /// Approved rewards that are not paid out yet.
  pendingAmount      Decimal  @default(0) @db.Decimal(18, 2)
  /// Funds received for program joins, recorded by an administrator.
  /// Deliberately separate from the reward balance.
  programFundsAmount Decimal  @default(0) @db.Decimal(18, 2)
  /// Withdrawable reward money that a pending withdrawal has already claimed.
  /// Moving money here is what prevents the same balance from being spent twice.
  reservedAmount     Decimal  @default(0) @db.Decimal(18, 2)
  totalEarned        Decimal  @default(0) @db.Decimal(18, 2)
  totalReversed      Decimal  @default(0) @db.Decimal(18, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Append-only ledger. Rows are never deleted and posted money fields are
/// frozen by a database trigger (see the program_engine migration).
model Transaction {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @db.Uuid
  userProgramId String?           @db.Uuid
  type          TransactionType
  status        TransactionStatus @default(PENDING)
  amount        Decimal           @db.Decimal(18, 2)
  currency      String            @default("USDT")
  /// Which balance bucket this entry moves: AVAILABLE, PENDING, PROGRAM_FUNDS or NONE.
  bucket        String            @default("NONE")
  balanceBefore Decimal           @db.Decimal(18, 2)
  balanceAfter  Decimal           @db.Decimal(18, 2)
  reference     String            @unique
  description   String?
  metadata      Json?
  postedAt      DateTime?
  reversedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userProgram        UserProgram?         @relation(fields: [userProgramId], references: [id], onDelete: SetNull)
  reward             Reward?
  commissionsSourced ReferralCommission[] @relation("CommissionSourceTransaction")
  commissionsPayouts ReferralCommission[] @relation("CommissionPayoutTransaction")

  @@index([userId, createdAt])
  @@index([status])
  @@index([type, createdAt])
}

model Reward {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @db.Uuid
  programId     String       @db.Uuid
  userProgramId String       @db.Uuid
  tierId        String       @db.Uuid
  type          RewardType
  status        RewardStatus @default(PENDING)
  amount        Decimal      @db.Decimal(18, 2)
  currency      String       @default("USDT")
  rate          Decimal      @db.Decimal(7, 4)
  /// Week number inside the cycle: 1..4.
  period        Int
  cycleNumber   Int          @default(1)
  scheduledFor  DateTime?
  approvedAt    DateTime?
  paidAt        DateTime?
  transactionId String?      @unique @db.Uuid
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  program     Program      @relation(fields: [programId], references: [id], onDelete: Restrict)
  userProgram UserProgram  @relation(fields: [userProgramId], references: [id], onDelete: Cascade)
  tier        ProgramTier  @relation(fields: [tierId], references: [id], onDelete: Restrict)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  /// Idempotency key: one reward row per user + program membership + period.
  /// Running the reward engine twice can therefore never pay a period twice.
  @@unique([userProgramId, type, cycleNumber, period])
  @@index([userId, status])
  @@index([userId, programId, period])
}

model Referral {
  id             String         @id @default(uuid()) @db.Uuid
  referrerId     String         @db.Uuid
  referredUserId String         @unique @db.Uuid
  level          Int            @default(1)
  codeUsed       String
  status         ReferralStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  referrer     User                 @relation("ReferralParent", fields: [referrerId], references: [id], onDelete: Restrict)
  referredUser User                 @relation("ReferralChild", fields: [referredUserId], references: [id], onDelete: Cascade)
  commissions  ReferralCommission[]

  @@unique([referrerId, referredUserId])
  @@index([referrerId])
}

/// One commission row per (source ledger event, beneficiary). The unique key makes
/// the engine idempotent: replaying the same posted transaction can never pay the
/// same upline twice.
model ReferralCommission {
  id                  String                   @id @default(uuid()) @db.Uuid
  referralId          String                   @db.Uuid
  /// The upline account that earns the commission (former `referrerId`).
  beneficiaryUserId   String                   @db.Uuid
  /// The downline account whose program event generated the commission.
  sourceUserId        String                   @db.Uuid
  /// Posted ledger entry that triggered the commission (PROGRAM_FUNDS bucket).
  sourceTransactionId String                   @db.Uuid
  level               Int
  rate                Decimal                  @db.Decimal(7, 4)
  baseAmount          Decimal                  @db.Decimal(18, 2)
  /// Commission value (former `amount`), always `baseAmount * rate` in Decimal.
  commissionAmount    Decimal                  @db.Decimal(18, 2)
  currency            String                   @default("USDT")
  status              ReferralCommissionStatus @default(PENDING)
  sourceReference     String
  approvedAt          DateTime?
  paidAt              DateTime?
  /// Ledger entry that credited the beneficiary when the commission was paid.
  payoutTransactionId String?                  @unique @db.Uuid
  postedAt            DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  referral          Referral     @relation(fields: [referralId], references: [id], onDelete: Cascade)
  beneficiary       User         @relation("CommissionBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: Cascade)
  sourceUser        User         @relation("CommissionSource", fields: [sourceUserId], references: [id], onDelete: Cascade)
  sourceTransaction Transaction  @relation("CommissionSourceTransaction", fields: [sourceTransactionId], references: [id], onDelete: Cascade)
  payoutTransaction Transaction? @relation("CommissionPayoutTransaction", fields: [payoutTransactionId], references: [id], onDelete: Restrict)

  /// The one and only idempotency key of the engine: a posted source transaction
  /// can never pay the same beneficiary twice. The legacy
  /// UNIQUE(referralId, sourceUserId, level, sourceReference) key was dropped by
  /// migration 20261009130000 because `sourceReference` is denormalised text and
  /// `createMany({ skipDuplicates: true })` would have silently swallowed a
  /// legitimate commission on any collision with it.
  @@unique([sourceTransactionId, beneficiaryUserId])
  @@index([beneficiaryUserId, status])
  @@index([sourceTransactionId])
}

/// Configured rebate (komisi rabat) percentage per generation.
///
/// This table is the single source of truth shared by the member dashboard, the
/// admin settings screen and the commission engine. Only generations 1..5 exist:
/// a database CHECK constraint rejects generation 6 and above. Historical
/// `ReferralCommission` rows keep the rate they were created with, so a later
/// configuration change never rewrites a past payout.
model RebateConfig {
  /// Network generation (1..5); the primary key guarantees one row per generation.
  generation Int      @id
  /// Percentage as a fraction (0.1000 = 10%), stored with exact decimal precision.
  rate       Decimal  @db.Decimal(7, 4)
  /// Administrator that last wrote this row (audit trail lives in `AuditLog`).
  updatedBy  String?  @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType @default(SYSTEM)
  title     String
  body      String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model SecurityEvent {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String?           @db.Uuid
  type        SecurityEventType
  severity    SecuritySeverity  @default(INFO)
  description String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime          @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  name              String
  username          String     @unique
  email             String     @unique
  phone             String     @unique
  /// Nomor rekening pendaftar untuk kebutuhan pembayaran/penarikan.
  /// Disimpan sebagai String agar angka nol di depan tetap terjaga.
  bankAccountNumber String?
  /// Bank / e-wallet pendaftar (kode stabil, mis. "BCA", "DANA"), dipilih dari
  /// daftar `BANK_VALUES` saat mendaftar (divalidasi di `registerSchema`).
  bank              String?
  passwordHash      String
  role              UserRole   @default(USER)
  /// Admin capability level; null means "may sign in to /admin but may do nothing".
  adminRole         AdminRole?
  status            UserStatus @default(ACTIVE)
  /// Only populated behind an explicitly trusted proxy; used at registration.
  registrationIp    String?
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  /// Konsol Pemilik (super admin tunggal). Rahasia TOTP tidak pernah disimpan
  /// sebagai teks biasa: nilainya dienkripsi AES-256-GCM dengan kunci
  /// `OWNER_2FA_KEY` (lihat `src/lib/owner/secret-box.ts`).
  ownerTotpSecret           String?
  /// Terisi hanya setelah pendaftaran 2FA dikonfirmasi dengan satu kode yang sah.
  ownerTotpEnabledAt        DateTime?
  /// Kode pemulihan sekali-pakai; hanya hash HMAC-nya yang disimpan.
  ownerTotpRecoveryCodes    Json?
  /// Langkah TOTP terakhir yang sudah dipakai, supaya satu kode tidak dapat
  /// dipakai dua kali (anti replay).
  ownerTotpLastStep         Int?

  profile             Profile?
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  userPrograms        UserProgram[]
  balance             Balance?
  transactions        Transaction[]
  rewards             Reward[]
  referralsMade       Referral[]           @relation("ReferralParent")
  referredByEntry     Referral?            @relation("ReferralChild")
  commissionsEarned   ReferralCommission[] @relation("CommissionBeneficiary")
  commissionsSourced  ReferralCommission[] @relation("CommissionSource")
  notifications       Notification[]
  securityEvents      SecurityEvent[]
  auditLogs           AuditLog[]
  depositRequests     DepositRequest[]     @relation("DepositOwner")
  depositsReviewed    DepositRequest[]     @relation("DepositReviewer")
  withdrawalRequests  WithdrawalRequest[]  @relation("WithdrawalOwner")
  withdrawalsReviewed WithdrawalRequest[]  @relation("WithdrawalReviewer")
  fraudReview         FraudReview?         @relation("FraudSubject")
  fraudReviewsHandled FraudReview[]        @relation("FraudReviewer")

  /// Modul Profit Trading (hasil trading aktual). Additive relations only: no
  /// existing column, index or behaviour of this model is changed.
  tradingRecordsAsTrader TradingRecord[]          @relation("TradingRecordTrader")
  tradingRecordsCreated  TradingRecord[]          @relation("TradingRecordCreator")
  tradingRecordsVerified TradingRecord[]          @relation("TradingRecordVerifier")
  tradingReportsCreated  TradingReport[]          @relation("TradingReportCreator")
  tradingReportsApproved TradingReport[]          @relation("TradingReportApprover")
  reconciliationsChecked TradingReconciliation[]  @relation("TradingReconciliationChecker")
  profitAllocations      ProfitAllocation[]       @relation("ProfitAllocationMember")
  profitAllocationsSet   ProfitAllocation[]       @relation("ProfitAllocationApprover")
  memberProfitLedger     MemberProfitLedger[]     @relation("MemberProfitLedgerMember")
  memberProfitLedgerSet  MemberProfitLedger[]     @relation("MemberProfitLedgerCreator")
  profitPayments         ProfitPayment[]          @relation("ProfitPaymentMember")
  profitPaymentsCreated  ProfitPayment[]          @relation("ProfitPaymentCreator")
  profitPaymentsVerified ProfitPayment[]          @relation("ProfitPaymentVerifier")
  tradingApprovalActions TradingApprovalHistory[] @relation("TradingApprovalActor")
  profitSharePoliciesSet ProfitSharePolicy[]      @relation("ProfitSharePolicyCreator")
  profitSharePoliciesOk  ProfitSharePolicy[]      @relation("ProfitSharePolicyApprover")
  /// Pihak perjanjian yang punya akun sistem (bukti persetujuan perjanjian).
  profitAgreementParties ProfitAgreementParty[]   @relation("ProfitAgreementPartyUser")

  /// Sumber modal trading (Tahap 2). Modal tidak pernah menentukan hak profit
  /// dengan sendirinya; dasar pembagian selalu diambil dari perjanjian.
  tradingCapitalAsMember  TradingCapitalContribution[] @relation("TradingCapitalMember")
  tradingCapitalRecorded  TradingCapitalContribution[] @relation("TradingCapitalCreator")
  tradingCapitalVerified  TradingCapitalContribution[] @relation("TradingCapitalVerifier")
  capitalMovementsCreated TradingCapitalMovement[]     @relation("TradingCapitalMovementCreator")

  @@index([status])
  @@index([createdAt])
  @@index([bankAccountNumber])
  @@index([registrationIp, createdAt])
}

/// A manual deposit request: the member reports money that was sent outside the
/// platform and attaches a proof file. Submitting never touches a balance; the
/// money is only credited when an administrator approves the request.
model DepositRequest {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @db.Uuid
  /// The pending membership this deposit is meant to fund.
  userProgramId    String        @db.Uuid
  amount           Decimal       @db.Decimal(18, 2)
  currency         String        @default("USDT")
  paymentMethod    String
  paymentReference String
  /// Private storage key (random file name) — never a user supplied path.
  proofStorageKey  String
  proofFileName    String
  proofMimeType    String
  proofSize        Int
  proofUploadedAt  DateTime      @default(now())
  status           DepositStatus @default(PENDING)
  reviewedByUserId String?       @db.Uuid
  reviewedAt       DateTime?
  rejectionReason  String?
  reviewNote       String?
  flaggedReason    String?
  /// Ledger reference of the credit entry created on approval (unique => one credit).
  ledgerReference  String?       @unique
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user        User        @relation("DepositOwner", fields: [userId], references: [id], onDelete: Cascade)
  userProgram UserProgram @relation(fields: [userProgramId], references: [id], onDelete: Restrict)
  reviewedBy  User?       @relation("DepositReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([userProgramId])
}

/// A manual withdrawal request. Submitting reserves the amount
/// (AVAILABLE -> RESERVED); completing it debits the reservation for good and
/// rejecting it returns the money to the spendable balance.
///
/// `amount` is the gross request (what the member typed), `fee` is the platform
/// fee (10% of the gross) and `netAmount` is what is actually paid out. The gross
/// is the single authoritative value reserved, released and settled, so a
/// withdrawal can never debit a balance twice; the fee is only a breakdown of
/// that same gross. Rows created before this fee existed have NULL fee/netAmount
/// and keep their original behaviour (fee 0, net = gross).
model WithdrawalRequest {
  id                  String           @id @default(uuid()) @db.Uuid
  userId              String           @db.Uuid
  amount              Decimal          @db.Decimal(18, 2)
  fee                 Decimal?         @db.Decimal(18, 2)
  netAmount           Decimal?         @db.Decimal(18, 2)
  currency            String           @default("USDT")
  method              String
  destination         String
  notes               String?
  status              WithdrawalStatus @default(PENDING)
  reviewedByUserId    String?          @db.Uuid
  reviewedAt          DateTime?
  rejectionReason     String?
  reviewNote          String?
  processedAt         DateTime?
  completedAt         DateTime?
  /// Ledger references for the reservation debit/credit pair and the final debit.
  reservedReference   String?          @unique
  completionReference String?          @unique
  proofStorageKey     String?
  proofFileName       String?
  proofMimeType       String?
  proofSize           Int?
  idempotencyKey      String?          @db.Uuid
  metadata            Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user       User  @relation("WithdrawalOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("WithdrawalReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([userId, idempotencyKey])
}

/// ============================================================================
/// Modul Profit Mingguan Berbasis Hasil Trading Aktual
/// ============================================================================
///
/// Seluruh penambahan di bawah bersifat aditif: tidak ada tabel, kolom, indeks,
/// atau enum lama yang diubah maupun dihapus. Angka pembagian hasil TIDAK
/// di-hardcode di sini: `ProfitSharePolicy` menyimpan kebijakan yang masih
/// menunggu persetujuan pemilik, dan sistem menolak menerbitkan/membayar laporan
/// selama kebijakan wajib belum berstatus APPROVED.

/// Asal data. Laporan profit hanya boleh dibangun dari record ACTUAL; record
/// DEMO tidak pernah masuk perhitungan profit anggota.
enum TradingSourceType {
  ACTUAL
  DEMO
}

/// Status verifikasi satu catatan trading sebelum boleh masuk laporan.
enum TradingRecordStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

/// Siklus hidup laporan profit mingguan (lihat docs/profit-trading-module-audit-and-plan.md).
///
/// `RULES_VALIDATION` adalah gerbang setelah rekonsiliasi: laporan diperiksa
/// terhadap aturan tertulis (perjanjian bagi hasil, pemisahan data demo, kerugian)
/// sebelum boleh diajukan. Gerbang ini gagal-tertutup: bila aturan belum tertulis,
/// laporan berhenti di sini dengan alasan `RULES_NOT_CONFIGURED`, bukan memakai
/// persentase karangan.
enum TradingReportStatus {
  DRAFT
  RECONCILIATION
  RULES_VALIDATION
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  PAYMENT_PROCESSING
  PAID
  REJECTED
  CORRECTED
}

/// Hasil pencocokan angka internal dengan angka sumber.
enum TradingReconciliationStatus {
  PENDING
  MATCHED
  UNRESOLVED
}

/// Status hak profit anggota atas satu laporan.
enum ProfitAllocationStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  VOID
}

/// Status pembayaran profit (dicatat manual + bukti, tanpa gateway otomatis).
enum ProfitPaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

/// Kebijakan bagi hasil menunggu persetujuan pemilik. Hanya baris APPROVED yang
/// boleh dipakai mesin alokasi.
enum ProfitSharePolicyStatus {
  PENDING_APPROVAL
  APPROVED
  REVOKED
}

/// Satu catatan transaksi trading aktual. Angka keuangan selalu Decimal; waktu UTC.
///
/// Idempotensi impor: `@@unique([exchange, externalReference, sourceType])` membuat
/// mengimpor berkas yang sama dua kali tidak pernah menggandakan catatan.
model TradingRecord {
  id                 String              @id @default(uuid()) @db.Uuid
  /// Referensi dari sumber (mis. trade id exchange). Bukan rahasia.
  externalReference  String
  traderName         String
  traderUserId       String?             @db.Uuid
  exchange           String
  assetPair          String
  tradeType          String
  executedAt         DateTime
  allocatedCapital   Decimal             @default(0) @db.Decimal(18, 2)
  /// Realized P&L: satu-satunya laba/rugi yang masuk Net Trading P&L.
  realizedPnl        Decimal             @db.Decimal(18, 2)
  /// Unrealized P&L disimpan untuk tampilan, TIDAK masuk Net Trading P&L.
  unrealizedPnl      Decimal?            @db.Decimal(18, 2)
  tradingFees        Decimal             @default(0) @db.Decimal(18, 2)
  otherCosts         Decimal             @default(0) @db.Decimal(18, 2)
  /// true bila P&L dari sumber SUDAH bersih setelah biaya, sehingga biaya tidak
  /// boleh dikurangkan dua kali (lihat trading-calculation.ts).
  costsIncludedInPnl Boolean             @default(false)
  currency           String              @default("USDT")
  sourceType         TradingSourceType   @default(ACTUAL)
  status             TradingRecordStatus @default(UNVERIFIED)
  /// Kunci berkas bukti di penyimpanan privat (bukan path yang bisa ditebak).
  evidenceStorageKey String?
  notes              String?
  importedBatchId    String?             @db.Uuid
  reportId           String?             @db.Uuid
  createdByUserId    String?             @db.Uuid
  verifiedByUserId   String?             @db.Uuid
  verifiedAt         DateTime?
  verificationNote   String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  traderUser User?          @relation("TradingRecordTrader", fields: [traderUserId], references: [id], onDelete: SetNull)
  createdBy  User?          @relation("TradingRecordCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  verifiedBy User?          @relation("TradingRecordVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  report     TradingReport? @relation("TradingRecordReport", fields: [reportId], references: [id], onDelete: SetNull)

  @@unique([exchange, externalReference, sourceType])
  @@index([sourceType, executedAt])
  @@index([status, executedAt])
  @@index([executedAt])
  @@index([reportId])
}

/// Laporan profit satu periode (mingguan). Satu baris = satu versi laporan.
///
/// Laporan yang sudah PUBLISHED tidak diubah diam-diam: koreksi membuat baris baru
/// dengan `version + 1` dan `correctsReportId` menunjuk laporan lama.
model TradingReport {
  id                       String              @id @default(uuid()) @db.Uuid
  periodStart              DateTime
  periodEnd                DateTime
  sourceType               TradingSourceType   @default(ACTUAL)
  version                  Int                 @default(1)
  correctsReportId         String?             @db.Uuid
  /// Versi perjanjian bagi hasil yang sah saat laporan ini dihitung.
  agreementId              String?             @db.Uuid
  status                   TradingReportStatus @default(DRAFT)
  currency                 String              @default("USDT")
  /// Snapshot angka saat laporan dikompilasi (agar laporan lama tidak berubah
  /// ketika catatan trading baru diimpor).
  realizedPnl              Decimal             @default(0) @db.Decimal(18, 2)
  unrealizedPnl            Decimal             @default(0) @db.Decimal(18, 2)
  tradingFees              Decimal             @default(0) @db.Decimal(18, 2)
  otherCosts               Decimal             @default(0) @db.Decimal(18, 2)
  netPnl                   Decimal             @default(0) @db.Decimal(18, 2)
  reserveAmount            Decimal             @default(0) @db.Decimal(18, 2)
  managementFeeAmount      Decimal             @default(0) @db.Decimal(18, 2)
  distributableAmount      Decimal             @default(0) @db.Decimal(18, 2)
  memberPoolAmount         Decimal             @default(0) @db.Decimal(18, 2)
  allocatedAmount          Decimal             @default(0) @db.Decimal(18, 2)
  paidAmount               Decimal             @default(0) @db.Decimal(18, 2)
  /// Bagian hasil yang tetap di perusahaan (distributable − jumlah hak anggota).
  /// Selalu hasil pengurangan angka laporan ini, bukan angka yang diketik manual.
  companyRetainedAmount    Decimal             @default(0) @db.Decimal(18, 2)
  /// Kerugian aktual periode ini sebagai angka positif (0 bila periode untung).
  /// Dicatat TERPISAH dari angka profit; nilainya |net P&L| saat net P&L negatif.
  lossAmount               Decimal             @default(0) @db.Decimal(18, 2)
  /// Ketentuan perjanjian yang dipakai atas kerugian tersebut (mis. CARRY_FORWARD,
  /// ABSORB_BY_COMPANY, HOLD). Null = belum ada ketentuan tertulis yang disetujui,
  /// sehingga kerugian hanya dicatat dan tidak dipindahkan ke siapa pun.
  lossHandlingApplied      String?
  /// Kerugian yang dibawa ke periode berikutnya; hanya terisi bila perjanjian
  /// yang disetujui memang mengatur carry-forward. Tidak pernah menjadi utang anggota.
  carriedForwardLossAmount Decimal             @default(0) @db.Decimal(18, 2)
  lossHandlingNote         String?
  /// Versi mesin perhitungan yang dipakai (agar hasil bisa direproduksi).
  computationVersion       String?
  /// Salinan input perhitungan (jumlah record, rentang, ringkasan) untuk audit.
  computationInputs        Json?
  /// Salinan formula/parameter yang dipakai saat perhitungan.
  computationFormula       Json?
  computedAt               DateTime?
  /// Salinan versi perjanjian bagi hasil yang dipakai saat kompilasi.
  policySnapshot           Json?
  summaryNote              String?
  createdByUserId          String?             @db.Uuid
  approvedByUserId         String?             @db.Uuid
  approvedAt               DateTime?
  publishedAt              DateTime?
  rejectionReason          String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  agreement       ProfitSharePolicy?       @relation("TradingReportAgreement", fields: [agreementId], references: [id], onDelete: SetNull)
  createdBy       User?                    @relation("TradingReportCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvedBy      User?                    @relation("TradingReportApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  corrects        TradingReport?           @relation("TradingReportCorrection", fields: [correctsReportId], references: [id], onDelete: SetNull)
  corrections     TradingReport[]          @relation("TradingReportCorrection")
  records         TradingRecord[]          @relation("TradingRecordReport")
  reconciliations TradingReconciliation[]
  allocations     ProfitAllocation[]
  payments        ProfitPayment[]          @relation("ProfitPaymentReport")
  approvals       TradingApprovalHistory[]

  @@unique([periodStart, periodEnd, sourceType, version])
  @@index([status, periodEnd])
  @@index([periodStart, periodEnd])
}

/// Pencocokan angka internal (dari catatan trading) dengan angka sumber.
/// Selama masih ada baris UNRESOLVED, laporan tidak boleh naik ke PENDING_APPROVAL.
model TradingReconciliation {
  id                 String                      @id @default(uuid()) @db.Uuid
  reportId           String                      @db.Uuid
  sourceLabel        String
  internalNetPnl     Decimal                     @db.Decimal(18, 2)
  sourceNetPnl       Decimal                     @db.Decimal(18, 2)
  /// internal - source; disimpan agar selisih tidak perlu dihitung ulang.
  difference         Decimal                     @db.Decimal(18, 2)
  tolerance          Decimal                     @default(0) @db.Decimal(18, 2)
  status             TradingReconciliationStatus @default(PENDING)
  notes              String?
  evidenceStorageKey String?
  checkedByUserId    String?                     @db.Uuid
  checkedAt          DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  report    TradingReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  checkedBy User?         @relation("TradingReconciliationChecker", fields: [checkedByUserId], references: [id], onDelete: SetNull)

  @@index([reportId, status])
}

/// Hak profit satu anggota atas satu laporan. Unik per (laporan, anggota) supaya
/// menjalankan mesin alokasi dua kali tidak pernah menggandakan hak anggota.
model ProfitAllocation {
  id               String                 @id @default(uuid()) @db.Uuid
  reportId         String                 @db.Uuid
  memberId         String                 @db.Uuid
  /// Dasar pembagian yang dipakai (mis. jumlah modal anggota) untuk audit.
  basisAmount      Decimal                @default(0) @db.Decimal(18, 2)
  shareRate        Decimal                @default(0) @db.Decimal(7, 4)
  amount           Decimal                @default(0) @db.Decimal(18, 2)
  currency         String                 @default("USDT")
  status           ProfitAllocationStatus @default(PENDING)
  /// Referensi entri buku besar saat hak ini dikreditkan ke saldo anggota.
  ledgerReference  String?                @unique
  approvedByUserId String?                @db.Uuid
  approvedAt       DateTime?
  paidAt           DateTime?
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  report        TradingReport        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  member        User                 @relation("ProfitAllocationMember", fields: [memberId], references: [id], onDelete: Cascade)
  approvedBy    User?                @relation("ProfitAllocationApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  ledgerEntries MemberProfitLedger[]
  payments      ProfitPayment[]

  @@unique([reportId, memberId])
  @@index([memberId, status])
  @@index([status, createdAt])
}

/// Jejak hak profit anggota yang bersifat append-only dan terpisah dari
/// `Transaction`: barisnya menjelaskan *dari mana* hak itu berasal. Koreksi
/// dilakukan dengan baris baru (`correctionOfId`), bukan dengan mengubah baris lama.
model MemberProfitLedger {
  id              String            @id @default(uuid()) @db.Uuid
  memberId        String            @db.Uuid
  allocationId    String?           @db.Uuid
  reportId        String?           @db.Uuid
  entryType       String
  amount          Decimal           @db.Decimal(18, 2)
  currency        String            @default("USDT")
  status          TransactionStatus @default(POSTED)
  reference       String            @unique
  correctionOfId  String?           @db.Uuid
  description     String?
  metadata        Json?
  postedAt        DateTime?
  createdByUserId String?           @db.Uuid
  createdAt       DateTime          @default(now())

  member       User                 @relation("MemberProfitLedgerMember", fields: [memberId], references: [id], onDelete: Cascade)
  createdBy    User?                @relation("MemberProfitLedgerCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  allocation   ProfitAllocation?    @relation(fields: [allocationId], references: [id], onDelete: SetNull)
  correctionOf MemberProfitLedger?  @relation("MemberProfitLedgerCorrection", fields: [correctionOfId], references: [id], onDelete: SetNull)
  corrections  MemberProfitLedger[] @relation("MemberProfitLedgerCorrection")

  @@index([memberId, createdAt])
  @@index([reportId])
}

/// Pencatatan pembayaran profit. Pembayaran TIDAK pernah otomatis: seorang
/// administrator mencatatnya, mengunggah bukti, lalu memverifikasi selesai.
/// `idempotencyKey` unik mencegah satu pembayaran tercatat dua kali.
model ProfitPayment {
  id                String              @id @default(uuid()) @db.Uuid
  allocationId      String              @db.Uuid
  memberId          String              @db.Uuid
  reportId          String              @db.Uuid
  amount            Decimal             @db.Decimal(18, 2)
  currency          String              @default("USDT")
  method            String
  destination       String?
  status            ProfitPaymentStatus @default(PENDING)
  providerReference String?
  idempotencyKey    String?             @unique
  /// Bukti pembayaran disimpan di penyimpanan privat (pola sama dengan bukti setoran).
  proofStorageKey   String?
  proofFileName     String?
  proofMimeType     String?
  proofSize         Int?
  failureReason     String?
  processedAt       DateTime?
  completedAt       DateTime?
  verifiedByUserId  String?             @db.Uuid
  createdByUserId   String?             @db.Uuid
  metadata          Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  allocation ProfitAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  member     User             @relation("ProfitPaymentMember", fields: [memberId], references: [id], onDelete: Cascade)
  report     TradingReport    @relation("ProfitPaymentReport", fields: [reportId], references: [id], onDelete: Cascade)
  verifiedBy User?            @relation("ProfitPaymentVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  createdBy  User?            @relation("ProfitPaymentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([memberId, status])
  @@index([reportId, status])
  @@index([status, createdAt])
}

/// Riwayat transisi status laporan. Setiap perubahan status wajib punya baris di
/// sini (aktor, waktu, alasan), sehingga tidak ada laporan yang berubah tanpa jejak.
model TradingApprovalHistory {
  id          String               @id @default(uuid()) @db.Uuid
  reportId    String               @db.Uuid
  fromStatus  TradingReportStatus?
  toStatus    TradingReportStatus
  action      String
  reason      String?
  actorUserId String?              @db.Uuid
  before      Json?
  after       Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime             @default(now())

  report TradingReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actor  User?         @relation("TradingApprovalActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([reportId, createdAt])
  @@index([actorUserId, createdAt])
}

/// PERJANJIAN bagi hasil (satu baris = satu versi perjanjian).
///
/// Sampai pemilik menyetujui isinya, baris ini berstatus PENDING_APPROVAL dan
/// mesin alokasi menolak berjalan (fail closed). Tidak ada persentase bawaan yang
/// dikarang di kode: `memberShareRate`, `reserveRate`, dan `managementFeeRate`
/// sengaja nullable dan hanya boleh diisi sesuai angka pada perjanjian tertulis.
///
/// Versi perjanjian tidak pernah ditimpa. Perubahan membuat baris baru dengan
/// `agreementVersion` naik dan `supersedesPolicyId` menunjuk versi sebelumnya,
/// sedangkan setiap laporan menyimpan salinan versi yang dipakainya di
/// `TradingReport.policySnapshot` — sehingga perubahan perjanjian tidak pernah
/// mengubah laporan historis secara diam-diam.
model ProfitSharePolicy {
  id                   String                  @id @default(uuid()) @db.Uuid
  /// Nomor perjanjian sebagaimana tertulis pada dokumen (bukan karangan sistem).
  agreementNumber      String?
  /// Versi perjanjian, mis. "1.0".
  agreementVersion     String?
  label                String
  status               ProfitSharePolicyStatus @default(PENDING_APPROVAL)
  /// Bagian hasil untuk anggota sebagai pecahan (mis. 0.5000 = 50%).
  memberShareRate      Decimal?                @db.Decimal(7, 4)
  /// Cadangan wajib sebelum dibagi, sebagai pecahan dari net P&L.
  reserveRate          Decimal?                @db.Decimal(7, 4)
  /// Biaya pengelolaan, sebagai pecahan dari net P&L.
  managementFeeRate    Decimal?                @db.Decimal(7, 4)
  /// Metode perhitungan pembagian hasil, sesuai perjanjian.
  distributionMethod   String?
  /// Dasar perhitungan (mis. realisasi bersih dari transaksi terverifikasi).
  pnlBasis             String?
  /// Biaya yang diperhitungkan dalam perhitungan pembagian.
  costTreatment        String?
  /// Ketentuan periode perhitungan (mis. minggu Senin–Minggu UTC).
  periodDefinition     String?
  /// Ketentuan koreksi laporan yang sudah terbit.
  correctionTerms      String?
  /// Ketentuan penyelesaian sengketa.
  disputeTerms         String?
  /// Kebijakan periode rugi. Nilai yang dikenal ada di profit-share-config.ts.
  lossHandling         String?
  distributionPeriod   String                  @default("WEEKLY")
  timezone             String                  @default("UTC")
  effectiveFrom        DateTime?
  /// Akhir masa berlaku perjanjian; null berarti masih berlaku.
  effectiveTo          DateTime?
  /// Versi perjanjian yang digantikan baris ini (rantai versi, bukan penimpaan).
  supersedesPolicyId   String?                 @db.Uuid
  /// Kunci berkas dokumen perjanjian di penyimpanan privat.
  agreementDocumentKey String?
  approvedByUserId     String?                 @db.Uuid
  approvedAt           DateTime?
  notes                String?
  createdByUserId      String?                 @db.Uuid
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  supersedes   ProfitSharePolicy?     @relation("ProfitSharePolicyRevision", fields: [supersedesPolicyId], references: [id], onDelete: SetNull)
  supersededBy ProfitSharePolicy[]    @relation("ProfitSharePolicyRevision")
  parties      ProfitAgreementParty[]
  reports      TradingReport[]        @relation("TradingReportAgreement")
  createdBy    User?                  @relation("ProfitSharePolicyCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvedBy   User?                  @relation("ProfitSharePolicyApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([status, effectiveFrom])
  @@index([agreementNumber, agreementVersion])
}

/// Bukti persetujuan satu perjanjian oleh pihak terkait (pemilik, trader, saksi).
///
/// Satu baris = satu pihak yang menyetujui satu versi perjanjian beserta waktunya.
/// Tabel ini sengaja TIDAK memuat persentase atau nominal apa pun: ia hanya
/// membuktikan siapa menyetujui perjanjian yang mana.
model ProfitAgreementParty {
  id                 String    @id @default(uuid()) @db.Uuid
  policyId           String    @db.Uuid
  /// Nama pihak sesuai dokumen perjanjian.
  partyName          String
  /// Peran pihak pada perjanjian (teks bebas; sistem tidak mengarang daftar peran).
  partyRole          String
  /// Akun sistem pihak tersebut, bila ia juga pengguna platform.
  userId             String?   @db.Uuid
  agreedAt           DateTime?
  /// Kunci berkas bukti persetujuan (tanda tangan/berita acara) di storage privat.
  evidenceStorageKey String?
  evidenceNote       String?
  createdAt          DateTime  @default(now())

  policy ProfitSharePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  user   User?             @relation("ProfitAgreementPartyUser", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([policyId, partyName, partyRole])
  @@index([policyId])
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Tahap 2 — Sumber modal trading
 */
/**
 * --------------------------------------------------------------------------
 */

/// Siapa yang menyediakan modal trading. Modal perusahaan dan modal anggota
/// dicatat terpisah supaya laporan tidak pernah mencampur keduanya.
enum CapitalOwnerType {
  COMPANY
  MEMBER
}

/// Status pencatatan satu sumber modal.
enum CapitalContributionStatus {
  /// Sudah dicatat, belum diperiksa.
  RECORDED
  /// Sudah diperiksa dan cocok dengan bukti.
  VERIFIED
  /// Ditolak; tidak dipakai perhitungan apa pun (baris tetap ada untuk jejak audit).
  REJECTED
  /// Sudah ditarik/dikembalikan; riwayatnya ada di `TradingCapitalMovement`.
  WITHDRAWN
}

/// Jenis pergerakan modal. Arah nilai ditentukan oleh jenis ini, bukan oleh tanda
/// angka: ALLOCATION, WITHDRAWAL, dan REVERSAL selalu bernilai positif, sedangkan
/// ADJUSTMENT boleh negatif sebagai saluran koreksi yang eksplisit.
enum CapitalMovementType {
  ALLOCATION
  WITHDRAWAL
  ADJUSTMENT
  REVERSAL
}

/// Satu pencatatan sumber modal (Tahap 2). Satu baris = satu pencatatan modal.
///
/// Aturan yang mengikat: modal **tidak** menentukan hak profit dengan sendirinya.
/// Dasar pembagian selalu diambil dari perjanjian bagi hasil yang sudah disetujui;
/// tabel ini hanya mencatat dari mana modal berasal, berapa, sejak kapan, dan siapa
/// yang memeriksanya. `reference` unik membuat pencatatan ganda tertolak di level
/// database, bukan hanya di level aplikasi.
model TradingCapitalContribution {
  id                 String                    @id @default(uuid()) @db.Uuid
  ownerType          CapitalOwnerType
  /// Wajib diisi bila `ownerType = MEMBER`; wajib kosong bila `COMPANY`.
  memberUserId       String?                   @db.Uuid
  amount             Decimal                   @db.Decimal(18, 2)
  currency           String                    @default("USDT")
  /// Tanggal modal mulai efektif (UTC).
  effectiveFrom      DateTime
  status             CapitalContributionStatus @default(RECORDED)
  /// Nomor bukti/dokumen sumber modal sebagaimana tertulis pada sumbernya.
  reference          String                    @unique
  /// Kunci berkas bukti di penyimpanan privat (bukan path yang bisa ditebak).
  evidenceStorageKey String?
  notes              String?
  createdByUserId    String?                   @db.Uuid
  verifiedByUserId   String?                   @db.Uuid
  verifiedAt         DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  member     User?                    @relation("TradingCapitalMember", fields: [memberUserId], references: [id], onDelete: SetNull)
  createdBy  User?                    @relation("TradingCapitalCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  verifiedBy User?                    @relation("TradingCapitalVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  movements  TradingCapitalMovement[]

  @@index([ownerType, effectiveFrom])
  @@index([memberUserId])
  @@index([status, effectiveFrom])
}

/// Riwayat perubahan alokasi modal — append-only.
///
/// Baris di sini tidak pernah diubah atau dihapus: koreksi dilakukan dengan baris
/// baru (REVERSAL/ADJUSTMENT) yang menunjuk baris asal lewat `revertsMovementId`.
/// Dengan begitu "berapa modal yang dikelola" selalu dapat dihitung ulang dari
/// riwayat, bukan dari angka yang ditimpa.
model TradingCapitalMovement {
  id                 String              @id @default(uuid()) @db.Uuid
  contributionId     String              @db.Uuid
  movementType       CapitalMovementType
  /// Nominal pergerakan. Positif untuk ALLOCATION/WITHDRAWAL/REVERSAL; ADJUSTMENT
  /// boleh negatif sebagai koreksi eksplisit.
  amount             Decimal             @db.Decimal(18, 2)
  currency           String              @default("USDT")
  effectiveAt        DateTime
  /// Alasan tertulis; wajib diisi — koreksi tanpa alasan tidak dapat diaudit.
  reason             String
  reference          String              @unique
  evidenceStorageKey String?
  /// Pergerakan yang dibatalkan baris ini (bila `movementType = REVERSAL`).
  revertsMovementId  String?             @db.Uuid
  createdByUserId    String?             @db.Uuid
  createdAt          DateTime            @default(now())

  contribution TradingCapitalContribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  reverts      TradingCapitalMovement?    @relation("TradingCapitalMovementReversal", fields: [revertsMovementId], references: [id], onDelete: SetNull)
  reversedBy   TradingCapitalMovement[]   @relation("TradingCapitalMovementReversal")
  createdBy    User?                      @relation("TradingCapitalMovementCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([contributionId, effectiveAt])
  @@index([movementType, effectiveAt])
}
