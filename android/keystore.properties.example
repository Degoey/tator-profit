# Copy this file to `keystore.properties` (git-ignored) to sign release builds.
#
#   keytool -genkeypair -v -keystore upload-key.jks -keyalg RSA -keysize 4096 \
#     -validity 10000 -alias tatorprofit
#
# Paths are resolved relative to the `android/` directory.
storeFile=upload-key.jks
storePassword=change-me
keyAlias=tatorprofit
keyPassword=change-me
