<?xml version="1.0" encoding="utf-8"?>
<!--
  Release / default policy: HTTPS only.

  The wrapper carries an authenticated administrator session, so cleartext is
  refused outright. The debug build overrides this file (see
  `src/debug/res/xml/network_security_config.xml`) so a local `npm run dev`
  server can be reached over plain HTTP.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
