<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (API 26+): the Tatorprofit mark floats on the brand ink
  background, so the launcher mask never crops it. `mipmap/ic_launcher_foreground`
  is generated by `android/tools/generate-icons.ps1`.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/brand_ink" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
