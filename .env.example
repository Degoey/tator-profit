# Copy to `.env` and adjust for your environment.
DATABASE_URL="postgresql://tatorprofit:tatorprofit@localhost:5432/tatorprofit?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Required (minimum 32 characters) in production and staging; the app refuses to start
# without it. Stay with the placeholder only for local development.
AUTH_TOKEN_SECRET="replace-with-32-byte-random-hex"

# Local development only. Never enable either switch in production or staging.
# TRUST_PROXY_HEADERS=1   # honour X-Forwarded-For (only behind a trusted reverse proxy)
# ALLOW_DEV_RESET_TOKEN=1 # return the password reset token from the API for local testing

# Local development only. Extra hosts allowed to load Next.js dev resources, so a
# phone or Android WebView can use `npm run dev` over your LAN address (10.0.2.2 is
# the host as seen from the Android emulator). Comma separated, no scheme or port.
# DEV_ALLOWED_ORIGINS="10.0.2.2,192.168.1.15"

# Customer service is WhatsApp-only. Use digits only, in international format: country
# code first, 8-15 digits, no "+", spaces, dashes or leading zero (Indonesian numbers
# therefore start with 62, never 08).
# Leave the placeholder as-is until the real number exists: without a valid value the
# button is hidden in production and shows a configuration hint in development.
NEXT_PUBLIC_WHATSAPP_CS_NUMBER="62xxxxxxxxxx"

# Pengujian. Database uji wajib terpisah dari DATABASE_URL dan namanya harus memuat
# "test". Tanpa nilai ini `npm test` berhenti sebelum menyentuh database mana pun.
# Siapkan sekali dengan `npm run db:test:setup` (lihat docs/test-database-isolation.md).
# TEST_DATABASE_URL="postgresql://tatorprofit:tatorprofit@localhost:5432/tatorprofit_test?schema=public"
