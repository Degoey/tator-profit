# Copy to `.env` and adjust for your environment.
DATABASE_URL="postgresql://tatorprofit:tatorprofit@localhost:5432/tatorprofit?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Minimum 32 characters in production; the app refuses to start without it.
AUTH_TOKEN_SECRET="replace-with-32-byte-random-hex"

# Local development only. Never enable either switch in production or staging.
# TRUST_PROXY_HEADERS=1   # honour X-Forwarded-For (only behind a trusted reverse proxy)
# ALLOW_DEV_RESET_TOKEN=1 # return the password reset token from the API for local testing
