# Copy to `.env` and adjust for your environment.
DATABASE_URL="postgresql://tatorprofit:tatorprofit@localhost:5432/tatorprofit?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# REQUIRED in production and staging (minimum 32 characters): the app refuses to
# start without it. >>> WAJIB DIGANTI dengan nilai acak saat deploy <<< — jangan
# pakai placeholder ini, jangan pakai nilai dev, jangan commit nilai aslinya.
# Contoh membuat nilai acak (32 byte):
#     openssl rand -hex 32
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Placeholder di bawah hanya boleh dipakai di pengembangan lokal.
AUTH_TOKEN_SECRET="replace-with-32-byte-random-hex"

# Runtime environment: "development" | "test" | "production" (Next.js sets this
# automatically for `next dev` / `next build`). Next.js also accepts "staging",
# which this app treats as strictly as production: AUTH_TOKEN_SECRET becomes
# mandatory and dev-only switches below are ignored. Produksi: biarkan Next.js
# yang mengisinya (jangan diset manual) — cukup pastikan build/run memakai
# NODE_ENV=production.
NODE_ENV="development"

# Local development only. Never enable either switch in production or staging.
# TRUST_PROXY_HEADERS=1 honours X-Forwarded-For / X-Real-IP. Only safe behind a
# reverse proxy you control; if the app is exposed directly, a client can spoof
# those headers (anti-fraud sees a fake IP). Produksi: set 1 HANYA bila berada di
# belakang proxy tepercaya (Nginx/Traefik/Cloudflare); selain itu biarkan kosong.
# TRUST_PROXY_HEADERS="1"
# ALLOW_DEV_RESET_TOKEN=1 makes the forgot-password API return the reset token in
# the response, for local testing only. It is hard-disabled when NODE_ENV is
# production or staging. Produksi: JANGAN pernah diaktifkan (biarkan kosong).
# ALLOW_DEV_RESET_TOKEN="1"

# Local development only. Extra hosts allowed to load Next.js dev resources, so a
# phone or Android WebView can use `npm run dev` over your LAN address (10.0.2.2 is
# the host as seen from the Android emulator). Comma separated, no scheme or port.
# Production builds ignore this list entirely. Produksi: kosongkan.
# DEV_ALLOWED_ORIGINS="10.0.2.2,192.168.1.15"

# Private directory for uploaded payment proofs (deposit receipts). Must live
# OUTSIDE `public/` — these files are private and served only through an
# authenticated API route. Default when unset: <project>/storage/payment-proofs.
# Must be a writable path (in Docker: a mounted volume). Produksi: mis.
# /var/lib/tatorprofit/payment-proofs, di-mount sebagai volume, bukan di dalam image.
PAYMENT_PROOF_DIR="./storage/payment-proofs"

# Customer service is WhatsApp-only. Use digits only, in international format: country
# code first, 8-15 digits, no "+", spaces, dashes or leading zero (Indonesian numbers
# therefore start with 62, never 08).
# Leave the placeholder as-is until the real number exists: without a valid value the
# button is hidden in production and shows a configuration hint in development.
NEXT_PUBLIC_WHATSAPP_CS_NUMBER="62xxxxxxxxxx"

# Pengujian. Database uji wajib terpisah dari DATABASE_URL dan namanya harus memuat
# "test". Tanpa nilai ini `npm test` berhenti sebelum menyentuh database mana pun.
# Siapkan sekali dengan `npm run db:test:setup` (lihat docs/test-database-isolation.md).
# Produksi: tidak dipakai — jangan arahkan ke database produksi.
TEST_DATABASE_URL="postgresql://tatorprofit:tatorprofit@localhost:5432/tatorprofit_test?schema=public"

# Skrip verifikasi end-to-end (`npm run verify:e2e`, `verify:routes`, `verify:payments`).
# Alamat aplikasi yang sedang berjalan; skrip ini membuat akun nyata lewat HTTP API
# lalu menghapusnya lagi. Produksi: jangan dijalankan terhadap produksi — skrip ini
# menolak berjalan bila NODE_ENV=production.
E2E_BASE_URL="http://localhost:3000"
# E2E_DEBUG=1 mencetak badan respons HTTP saat status >= 400 (hanya untuk diagnosa).
E2E_DEBUG=""
# E2E_DUMP=1 menyimpan HTML respons ke berkas agar bisa diperiksa manual.
E2E_DUMP=""
# E2E_KEEP=1 tidak menghapus akun verifikasi setelah selesai (untuk pemeriksaan).
# Produksi: biarkan kosong — nilai ini hanya menumpuk data uji di database.
E2E_KEEP=""

# Skrip demo lokal (`npm run demo:local`) yang mengisi dashboard dengan angka nyata.
# Alamat aplikasi yang sedang berjalan. Produksi: jangan dijalankan.
DEMO_BASE_URL="http://localhost:3000"
