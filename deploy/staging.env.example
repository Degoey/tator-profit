# =============================================================================
# Template variabel lingkungan STAGING untuk TatorProfit.
#
# Salin menjadi `.env.staging` DI VPS, isi nilai sebenarnya, lalu `chmod 600`.
# JANGAN commit `.env.staging` (sudah dicakup `.gitignore`: `.env.*`).
# JANGAN pakai nilai pengembangan di sini — staging diperlakukan seperti produksi.
#
#   cp deploy/staging.env.example .env.staging
#   # isi nilai, lalu:
#   chmod 600 .env.staging
# =============================================================================

# --- Database staging (terpisah dari development, jangan pernah sama) --------
# TODO-VPS: ganti password dengan nilai acak kuat. Akun ini hanya boleh memiliki
# hak atas database `tatorprofit_staging` (bukan superuser).
POSTGRES_USER="tatorprofit_staging"
POSTGRES_PASSWORD="CHANGE_ME_strong_random_password"
POSTGRES_DB="tatorprofit_staging"

# --- URL publik aplikasi -----------------------------------------------------
# Di-*inline* ke bundle klien saat `docker build`, jadi harus benar SEBELUM build.
# TODO-VPS: ganti dengan domain staging nyata (HTTPS).
NEXT_PUBLIC_APP_URL="https://staging.tatorprofit.example"

# --- Nomor WhatsApp CS (publik, boleh kosongkan sampai nomor nyata ada) ------
NEXT_PUBLIC_WHATSAPP_CS_NUMBER="62xxxxxxxxxx"

# --- Secret sesi: WAJIB di staging, minimal 32 karakter ----------------------
# Buat nilai acak di VPS:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN_SECRET="CHANGE_ME_32_byte_random_hex"

# --- Runtime -----------------------------------------------------------------
# Staging diperlakukan seperti produksi oleh aplikasi. Nilai ini juga dipakai
# oleh container app; biarkan apa adanya.
NODE_ENV="staging"

# Berada di belakang reverse proxy tepercaya (Nginx). Nyalakan HANYA bila benar
# ada proxy yang menimpa header X-Forwarded-For/X-Real-IP.
TRUST_PROXY_HEADERS="1"

# JANGAN diaktifkan di staging/produksi (biarkan kosong).
# ALLOW_DEV_RESET_TOKEN=""
